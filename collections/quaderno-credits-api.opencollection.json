{
  "opencollection": "1.0.0",
  "info": {
    "name": "Quaderno Authentication Credits API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Credits",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List credit notes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.quadernoapp.com/api/credits.json",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for paginated results (25 records per page)."
              }
            ]
          },
          "docs": "List credit notes"
        },
        {
          "info": {
            "name": "Create a credit note",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{account}.quadernoapp.com/api/credits.json",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a credit note"
        },
        {
          "info": {
            "name": "Retrieve a credit note",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.quadernoapp.com/api/credits/:id.json",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique ID of the resource."
              }
            ]
          },
          "docs": "Retrieve a credit note"
        },
        {
          "info": {
            "name": "Update a credit note",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{account}.quadernoapp.com/api/credits/:id.json",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique ID of the resource."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a credit note"
        },
        {
          "info": {
            "name": "Delete a credit note",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{account}.quadernoapp.com/api/credits/:id.json",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique ID of the resource."
              }
            ]
          },
          "docs": "Delete a credit note"
        }
      ]
    }
  ],
  "bundled": true
}
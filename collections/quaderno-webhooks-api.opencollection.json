{
  "opencollection": "1.0.0",
  "info": {
    "name": "Quaderno Authentication Webhooks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.quadernoapp.com/api/webhooks.json"
          },
          "docs": "List webhooks"
        },
        {
          "info": {
            "name": "Create a webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{account}.quadernoapp.com/api/webhooks.json",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Subscribes a URL to real-time event notifications. Quaderno POSTs a JSON payload over HTTPS when subscribed events occur and retries hourly (up to 72 hours) if the endpoint does not respond with a 200."
        },
        {
          "info": {
            "name": "Retrieve a webhook",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.quadernoapp.com/api/webhooks/:id.json",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique ID of the resource."
              }
            ]
          },
          "docs": "Retrieve a webhook"
        },
        {
          "info": {
            "name": "Update a webhook",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{account}.quadernoapp.com/api/webhooks/:id.json",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique ID of the resource."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a webhook"
        },
        {
          "info": {
            "name": "Delete a webhook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{account}.quadernoapp.com/api/webhooks/:id.json",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique ID of the resource."
              }
            ]
          },
          "docs": "Delete a webhook"
        }
      ]
    }
  ],
  "bundled": true
}
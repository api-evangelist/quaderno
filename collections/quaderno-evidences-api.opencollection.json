{
  "opencollection": "1.0.0",
  "info": {
    "name": "Quaderno Authentication Evidences API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Evidences",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List evidences",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.quadernoapp.com/api/evidences.json",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for paginated results (25 records per page)."
              }
            ]
          },
          "docs": "Lists location evidence records supporting tax determination."
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "Quaderno Authentication Invoices API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Invoices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List invoices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.quadernoapp.com/api/invoices.json",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for paginated results (25 records per page)."
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Full-text search across invoice fields."
              },
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "Filter by invoice state."
              }
            ]
          },
          "docs": "List invoices"
        },
        {
          "info": {
            "name": "Create an invoice",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{account}.quadernoapp.com/api/invoices.json",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an invoice"
        },
        {
          "info": {
            "name": "Retrieve an invoice",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.quadernoapp.com/api/invoices/:id.json",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique ID of the resource."
              }
            ]
          },
          "docs": "Retrieve an invoice"
        },
        {
          "info": {
            "name": "Update an invoice",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{account}.quadernoapp.com/api/invoices/:id.json",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique ID of the resource."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an invoice"
        },
        {
          "info": {
            "name": "Delete an invoice",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{account}.quadernoapp.com/api/invoices/:id.json",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique ID of the resource."
              }
            ]
          },
          "docs": "Delete an invoice"
        },
        {
          "info": {
            "name": "Deliver an invoice by email",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.quadernoapp.com/api/invoices/:id/deliver.json",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique ID of the resource."
              }
            ]
          },
          "docs": "Sends the invoice to the contact's email address."
        }
      ]
    }
  ],
  "bundled": true
}